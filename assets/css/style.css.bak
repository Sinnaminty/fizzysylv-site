/* ================================

   fizzysylv.xyz – FIZZY THEME
   Soda fox, paw pads, bubbly pastel
   ================================ */


:root {
  /* pulled from your ref sheet vibe */
  --bg: #ffe6f4;
  /* light pink background */
  --bg-alt: #ffd6ef;
  /* slightly deeper pink */
  --fg: #4a1634;
  /* dark berry text */

  --fg-soft: #7b305b;
  /* softer plum text */

  --fg-muted: #a45582;
  /* muted plum */

  --fizzy-main: #ff6a98;
  /* markings / main pink */
  --fizzy-deep: #ff336c;
  /* stronger accent pink */
  --fizzy-cream: #ffeef7;
  /* main card background */
  --fizzy-yellow: #ffd447;
  /* yellow paw pad */
  --fizzy-lavender: #d18cff;
  /* purple paw pad */
  --fizzy-tab: #b98b3b;
  /* soda tab / gold */
  --border-soft: #ffc2dc;

  --radius-sm: 0.75rem;
  --radius-md: 1.1rem;
  --radius-lg: 1.6rem;

  --shadow-soft: 0 10px 30px rgba(226, 93, 152, 0.35);


  --font-sans: system-ui, -apple-system, BlinkMacSystemFont, "SF Pro Text",
    "Segoe UI", sans-serif;
}



/* Reset-ish */

*,
*::before,
*::after {
  box-sizing: border-box;

}

html,

body {
  margin: 0;
  padding: 0;
}


/* Base */

body {

  font-family: var(--font-sans);
  background:
    radial-gradient(circle at top left, #ffe6f7 0, #ffe0f5 30%, #ffd2ef 60%, #ffc1e7 100%);
  color: var(--fg);
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;

}


/* Layout helpers */

.container {
  width: 100%;

  max-width: 960px;
  margin: 0 auto;
  padding: 0 1.25rem;
}

.section {
  padding: 3.25rem 0;
}

.section.alt {
  background: linear-gradient(135deg, #ffe9f7, #ffd6ef);
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.8);
}

.section-intro {
  max-width: 40rem;
  color: var(--fg-soft);
}

/* Header */

.site-header {
  position: sticky;

  top: 0;
  z-index: 20;
  backdrop-filter: blur(14px);
  background: linear-gradient(90deg,
      rgba(255, 250, 254, 0.92),
      rgba(255, 230, 245, 0.95));

  border-bottom: 1px solid rgba(255, 171, 210, 0.85);
}

.header-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0.7rem 0;
}

.logo {
  font-weight: 800;
  letter-spacing: 0.06em;

  text-transform: uppercase;

  color: var(--fizzy-deep);
  text-decoration: none;
  font-size: 0.95rem;
}

.logo span {
  color: var(--fizzy-yellow);
}

.nav a {
  text-decoration: none;
  color: var(--fg-muted);

  font-size: 0.95rem;
  margin-left: 1.4rem;
  position: relative;
}

.nav a::after {
  content: "";
  position: absolute;
  left: 0;
  bottom: -0.25rem;
  width: 0;
  height: 3px;
  border-radius: 999px;
  background: linear-gradient(90deg, var(--fizzy-lavender), var(--fizzy-yellow));
  transition: width 0.18s ease-out;
}

.nav a:hover {
  color: var(--fg);
}

.nav a:hover::after {
  width: 100%;
}

/* Hero */

.hero {
  padding: 4rem 0 3rem;
}

.hero.small {
  padding: 3rem 0 2.25rem;
}

.hero-inner {
  display: grid;
  grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
  gap: 2.25rem;
  align-items: center;
}

.eyebrow {
  text-transform: uppercase;
  letter-spacing: 0.18em;

  font-size: 0.8rem;
  color: var(--fizzy-lavender);
  margin: 0 0 0.7rem;
}

.hero h1 {
  font-size: clamp(2.1rem, 3vw, 2.7rem);
  margin: 0 0 0.6rem;
}


.hero-subtitle {
  margin: 0.3rem 0 1.4rem;
  font-size: 1rem;
  color: var(--fg-soft);
  max-width: 34rem;

}


.hero-note {

  margin-top: 1.3rem;
  color: var(--fg-muted);

  font-size: 0.93rem;
}

.accent {
  color: var(--fizzy-deep);
}

.hero-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 0.8rem;
}

/* Buttons – bubbly soda tabs */

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0.55rem 1.2rem;
  border-radius: 999px;
  font-size: 0.92rem;
  font-weight: 600;
  border: none;

  cursor: pointer;
  text-decoration: none;
  transition: transform 0.1s ease-out, box-shadow 0.1s ease-out,
    filter 0.1s ease-out;
}

.btn.primary {
  background: radial-gradient(circle at 20% 0, #ffeef9, #ff7bac);
  color: #3e102b;
  box-shadow: var(--shadow-soft);
}


.btn.primary:hover {
  transform: translateY(-1px);
  filter: brightness(1.05);
  box-shadow: 0 14px 30px rgba(226, 93, 152, 0.5);
}

.btn.outline {
  background: rgba(255, 255, 255, 0.7);
  border: 1px solid var(--border-soft);
  color: var(--fg-soft);
  box-shadow: 0 6px 16px rgba(212, 120, 170, 0.25);
}

.btn.outline:hover {
  filter: brightness(1.03);
}

/* Hero photo – soda bubble badge */

.hero-photo {
  display: flex;
  justify-content: center;
}

.photo-frame {
  position: relative;
  width: 220px;
  height: 220px;
  border-radius: 999px;
  padding: 6px;
  background:

    radial-gradient(circle at 0 0, #fff8fe 0, #ffe0f4 35%, #ffb6dd 80%),
    conic-gradient(from 160deg, #ff9fc1, #ffd447, #d18cff, #ff9fc1);
  box-shadow: 0 16px 40px rgba(226, 93, 152, 0.6);
}

.photo-frame::after {
  content: "";
  position: absolute;
  inset: 10% 8%;
  border-radius: inherit;
  border: 2px dashed rgba(255, 255, 255, 0.8);
  pointer-events: none;
}

.photo-frame img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  border-radius: inherit;
  border: 3px solid #ffeef7;
}

/* About */


.two-column {
  display: grid;
  gap: 2rem;
  grid-template-columns: minmax(0, 3fr) minmax(0, 2.5fr);
}

.highlight-box {
  background: var(--fizzy-cream);
  border-radius: var(--radius-lg);
  padding: 1.5rem 1.7rem;
  border: 1px solid var(--border-soft);
  box-shadow: var(--shadow-soft);
}

.highlight-box h3 {
  margin-top: 0;
}

.highlight-box ul {
  padding-left: 1.2rem;
  margin: 0.75rem 0 0;
  color: var(--fg-soft);
}

/* Cards / Projects – rounded soda cards */

.card-grid {
  display: grid;

  grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
  gap: 1.5rem;

  margin-top: 1.6rem;
}

.card {
  background: var(--fizzy-cream);
  border-radius: var(--radius-md);
  padding: 1.2rem 1.35rem;
  border: 1px solid rgba(255, 171, 210, 0.9);
  box-shadow: var(--shadow-soft);
  position: relative;
  overflow: hidden;
}

.card::before {
  /* soft bubbly highlight in corner */
  content: "";

  position: absolute;
  top: -40px;
  right: -40px;
  width: 120px;
  height: 120px;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.86), transparent);
  opacity: 0.7;
}

.card h3 {
  margin-top: 0.1rem;
  margin-bottom: 0.45rem;
  font-size: 1.05rem;
}

.card p {
  margin-top: 0.25rem;
  margin-bottom: 0.7rem;
  color: var(--fg-soft);
  font-size: 0.95rem;
}

.tag-list {
  list-style: none;
  padding: 0;
  margin: 0 0 0.75rem;
  display: flex;
  flex-wrap: wrap;
  gap: 0.4rem;
}

.tag-list li {
  font-size: 0.78rem;
  padding: 0.15rem 0.6rem;
  border-radius: 999px;
  background: linear-gradient(135deg,
      rgba(255, 174, 211, 0.9),

      rgba(255, 212, 87, 0.85));
  color: #5e1636;
}

.card-links a {
  font-size: 0.9rem;
  color: var(--fizzy-deep);
  text-decoration: none;
  position: relative;

}

.card-links a::after {
  content: "↗";
  margin-left: 0.18rem;
  font-size: 0.8rem;
}

.card-links a:hover {
  text-decoration: underline;
}

/* Skills */

.skills-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));

  gap: 1.5rem;
  margin-top: 1.25rem;
}

.skills-grid h3 {
  margin-top: 0;
  font-size: 1rem;
}

.skills-grid ul {

  padding-left: 1.1rem;
  margin-top: 0.5rem;
  color: var(--fg-soft);
}

/* Contact / Socials */


.contact-grid {
  display: grid;
  grid-template-columns: minmax(0, 3fr) minmax(0, 2.5fr);
  gap: 2rem;
  margin-top: 1rem;
}

.contact-links p {

  margin: 0 0 0.4rem;
  font-size: 0.95rem;
}

.contact-links a {

  color: var(--fizzy-deep);
  text-decoration: none;
  font-weight: 600;
}

.contact-links a:hover {
  text-decoration: underline;
}

.resume-cta {
  margin-top: 2rem;
}

/* Blog */

body.blog {
  background: radial-gradient(circle at top, #ffe9f8 0, #ffd2ef 55%, #ffc1e7 100%);
}

.post-list {
  list-style: none;
  padding: 0;
  margin: 1.5rem 0 0;
}


.post-item {
  padding: 1rem 0;
  border-bottom: 1px dashed rgba(255, 171, 210, 0.9);
}

.post-item:last-child {

  border-bottom: none;
}

.post-title {
  font-size: 1.05rem;
  font-weight: 600;
  color: var(--fg);
  text-decoration: none;

}


.post-title:hover {

  color: var(--fizzy-deep);
}

.post-meta {
  font-size: 0.8rem;
  color: var(--fg-muted);

  margin-bottom: 0.3rem;
}

.post-excerpt {
  color: var(--fg-soft);
  margin: 0.25rem 0 0;
  font-size: 0.93rem;

}

.post {
  max-width: 720px;
}

.post h1 {

  margin-top: 0.3rem;
  margin-bottom: 0.75rem;
}

.post h2 {
  margin-top: 1.5rem;
}

/* Footer */

.site-footer {
  border-top: 1px solid rgba(255, 171, 210, 0.9);
  margin-top: 2rem;
  background: linear-gradient(90deg, #ffe9f7, #ffd6ef);
}

.footer-inner {
  display: flex;

  align-items: center;
  justify-content: space-between;
  padding: 0.9rem 0;
  font-size: 0.85rem;
  color: var(--fg-muted);
}

.site-footer a {
  color: var(--fizzy-deep);
  text-decoration: none;

}

.site-footer a:hover {
  text-decoration: underline;
}

/* Typography */

h2 {
  margin: 0 0 0.8rem;
  font-size: 1.45rem;
}

h3 {
  font-size: 1.05rem;

}


p {
  margin-top: 0.4rem;

}


/* Generic links */

a {
  color: var(--fizzy-deep);
}

/* Responsive */

@media (max-width: 800px) {

  .hero-inner,
  .two-column,
  .contact-grid {
    grid-template-columns: minmax(0, 1fr);
  }

  .hero {
    padding-top: 3.25rem;
  }

  .hero-photo {

    order: -1;
    margin-bottom: 1.25rem;
  }


  .header-inner {

    flex-direction: column;
    align-items: flex-start;
    gap: 0.4rem;
  }

  .nav a {
    margin-left: 0;
    margin-right: 1.1rem;
    font-size: 0.9rem;
  }


  .footer-inner {

    flex-direction: column;
    align-items: flex-start;
    gap: 0.35rem;
  }
}
